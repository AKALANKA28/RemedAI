OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.1

# Fallback model used only if an agent-specific model is not set.
OLLAMA_MODEL=phi3:mini

# Agent-specific local Ollama models.
OLLAMA_ORCHESTRATOR_MODEL=gemma2:2b
OLLAMA_INTAKE_MODEL=qwen2.5:7b
OLLAMA_COMPLIANCE_MODEL=llama3.1:8b
OLLAMA_RISK_MODEL=mistral:7b
OLLAMA_PLANNER_MODEL=phi3:mini

# Optional comma-separated fallback models to try when the primary model fails.
OLLAMA_FALLBACK_MODELS=gemma2:2b,qwen2.5:7b,llama3.1:8b,mistral:7b

OLLAMA_KEEP_ALIVE=0
OLLAMA_CONTEXT_LENGTH=2048

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ctse-remedai
APP_RUNTIME_DIR=runtime
CASE_DB_PATH=data/seed/company_knowledge.db
CHECKPOINT_DB_PATH=runtime/checkpoints/langgraph_state.db
ALLOW_LANGSMITH_FALLBACK=true
